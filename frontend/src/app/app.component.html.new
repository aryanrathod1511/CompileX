<main class="min-h-screen bg-slate-950 p-4 text-slate-100">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 lg:flex-row">
    <section class="w-full rounded-3xl border border-slate-800 bg-slate-900/90 p-4 shadow-2xl shadow-slate-950/50 lg:w-2/3">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-2xl font-semibold">Code Executor</h1>
          <p class="text-sm text-slate-400">Build and run code with a polished Angular front end.</p>
        </div>
        <div class="flex items-center gap-2">
          <mat-form-field appearance="outline" class="w-36">
            <mat-label>Language</mat-label>
            <mat-select [(ngModel)]="language">
              <mat-option value="python">Python</mat-option>
              <mat-option value="cpp">C++</mat-option>
              <mat-option value="java">Java</mat-option>
            </mat-select>
          </mat-form-field>
          <button mat-flat-button color="primary" (click)="runCode()" [disabled]="isRunning">
            {{ isRunning ? 'Running…' : 'Run Code' }}
          </button>
        </div>
      </div>

      <mat-form-field appearance="outline" class="w-full">
        <mat-label>Source code</mat-label>
        <textarea matInput rows="18" [(ngModel)]="code" spellcheck="false"></textarea>
      </mat-form-field>
    </section>

    <section class="w-full rounded-3xl border border-slate-800 bg-slate-900/90 p-4 shadow-2xl shadow-slate-950/50 lg:w-1/3">
      <div class="mb-3 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Output Console</h2>
          <p class="text-sm text-slate-400">Status: {{ status }}</p>
        </div>
        <button mat-stroked-button color="accent" (click)="clearOutput()">Clear</button>
      </div>

      <pre class="min-h-[18rem] overflow-auto rounded-2xl border border-slate-800 bg-slate-950 p-3 font-mono text-sm text-slate-200">{{ output || 'Run your code to see terminal output here.' }}</pre>

      <div class="mt-3 flex gap-2">
        <mat-form-field appearance="outline" class="flex-1">
          <mat-label>Send input</mat-label>
          <input matInput [(ngModel)]="inputValue" (keyup.enter)="sendInput()" />
        </mat-form-field>
        <button mat-flat-button color="primary" (click)="sendInput()">Send</button>
      </div>
    </section>
  </div>
</main>
